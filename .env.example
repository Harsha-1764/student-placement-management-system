# Backend database settings are read by the Node API server.
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=placement_management
DB_PORT=3306
PORT=5000

# Vite uses this value for browser requests. The default is http://localhost:5000/api.
VITE_API_BASE_URL=http://localhost:5000/api

# Comma-separated browser origins allowed to send secure session cookies.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-managed session lifetime. Remember-me sessions use REMEMBER_ME_DAYS.
SESSION_TTL_HOURS=8
REMEMBER_ME_DAYS=30
COOKIE_SAME_SITE=lax

# Set this only when Express should serve an already-built frontend.
SERVE_FRONTEND=false
NODE_ENV=development
